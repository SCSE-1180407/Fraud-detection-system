<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>${title} - SentraX</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="${ctx}/assets/style.css"></head><body>
<header class="top"><a class="brand" href="${ctx}/dashboard">SentraX</a>
<nav aria-label="Main"><a href="${ctx}/dashboard" class="${active=='dash'?'on':''}">Dashboard</a>
<a href="${ctx}/submit" class="${active=='submit'?'on':''}">New transaction</a>
<a href="${ctx}/alerts" class="${active=='alerts'?'on':''}">Alerts</a></nav>
<span style="color:var(--mut)"><c:out value="${sessionScope.user.username}"/></span>
<a class="btn ghost sm" href="${ctx}/logout">Sign out</a></header><main>
